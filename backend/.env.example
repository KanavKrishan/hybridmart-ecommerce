NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call this API (your Vercel URL).
FRONTEND_ORIGIN=http://localhost:5173
# true = also allow https://*.vercel.app preview deployments
ALLOW_VERCEL_PREVIEWS=false

# ---- SQL database: mysql (production) or sqlite (local dev only) ----
SQL_DIALECT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hybrid_ecommerce_store
# auto = TLS for remote hosts, off for localhost. Use true/false to force.
MYSQL_SSL=auto
# MYSQL_CA_PATH=./certs/ca.pem
# SQLITE_PATH=./data/store.sqlite

# ---- MongoDB (carts, wishlists, reviews) ----
MONGO_URI=mongodb://127.0.0.1:27017/hybrid_ecommerce_store
# MONGO_DB_NAME=hybrid_ecommerce_store

# ---- Python analytics service ----
ANALYTICS_URL=http://127.0.0.1:5001
ANALYTICS_API_KEY=
ANALYTICS_TIMEOUT_MS=60000

# Load demo users/products on boot when the users table is empty.
SEED_ON_START=false
# SEED_ADMIN_PASSWORD=choose-a-strong-password
