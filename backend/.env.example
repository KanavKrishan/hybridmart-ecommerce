PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_lab_secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173

# mysql (preferred) or sqlite (automatic fallback if MySQL login fails)
SQL_DIALECT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hybrid_ecommerce_store

SQLITE_PATH=./data/store.sqlite

MONGO_URI=mongodb://127.0.0.1:27017/hybrid_ecommerce_store

# Flask analytics service (Node calls this; the browser never does)
ANALYTICS_URL=http://127.0.0.1:5001
ANALYTICS_TIMEOUT_MS=15000
