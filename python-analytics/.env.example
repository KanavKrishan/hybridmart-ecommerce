# Same SQL database as the backend (the two services must read the same data).
SQL_DIALECT=mysql
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database
# auto = TLS for remote hosts, off for localhost. Use true/false to force.
MYSQL_SSL=auto

# Must equal ANALYTICS_API_KEY on the backend. Leave empty only for local dev.
ANALYTICS_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
LOW_STOCK_THRESHOLD=5
